# ==============================================================================
# Zoho Mail IMAP Connection (Fill this when connecting Zoho)
# ==============================================================================
# Zoho IMAP host:
# For regular/personal Zoho: imap.zoho.com
# For Zoho Workplace / Organization / Custom Domains: imappro.zoho.com
# For India region (.in): imap.zoho.in
ZOHO_IMAP_HOST=imappro.zoho.com
ZOHO_IMAP_PORT=993
ZOHO_IMAP_SECURE=true

# Your Zoho email address
ZOHO_EMAIL=your_email@domain.com

# Zoho App Password (Generate from accounts.zoho.com -> Security -> App Passwords)
ZOHO_APP_PASSWORD=your_zoho_app_password_here

# Mailbox folder to monitor (typically INBOX)
ZOHO_MAILBOX=INBOX

# Fallback polling interval in milliseconds (default 5 minutes = 300000ms)
POLL_INTERVAL_MS=300000

# ==============================================================================
# Local Ollama AI Settings
# ==============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Choose from your installed models: llama3:latest, phi3:latest, etc.
OLLAMA_MODEL=llama3:latest

# ==============================================================================
# On-Device Storage & Sync Settings
# ==============================================================================
SQLITE_DB_PATH=./data/surveys_agent.db
CSV_EXPORT_PATH=./exports/surveys_extracted.csv

# Auto-sync to main ya_project MySQL database
ENABLE_MYSQL_SYNC=true
# Default platform name under which email surveys will be categorized in ya_platform
DEFAULT_PLATFORM_NAME=EmailCustom
DEFAULT_CURRENCY_CODE=USD
