{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "npm run electron:dev",
    "desktop:preview": "npm run electron:preview",
    "desktop:build": "npm run electron:build:mac",
    "electron": "electron .",
    "electron:dev": "concurrently -k -s first \"npm run dev\" \"wait-on -d 500 tcp:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-packager . \"Wanhong Survey\" --out=release --overwrite --prune=true --ignore=\"^/(src|release)\"",
    "electron:build:mac": "npm run build && electron-packager . \"Wanhong Survey\" --platform=darwin --arch=arm64 --out=release --overwrite --prune=true --ignore=\"^/(src|release)\"",
    "electron:build:win": "npm run build && electron-packager . \"Wanhong Survey\" --platform=win32 --arch=x64 --out=release --overwrite --prune=true --ignore=\"^/(src|release)\""
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^41.7.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "vite": "^5.4.10",
    "wait-on": "^8.0.5"
  }
}
