{
  "name": "surveystream-backend",
  "version": "1.0.0",
  "description": "SurveyStream Node.js survey and offerwall backend platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "desktop": "npm --prefix frontend run electron:dev",
    "desktop:preview": "npm --prefix frontend run electron:preview",
    "desktop:build": "npm --prefix frontend run electron:build",
    "desktop:build:win": "npm --prefix frontend run electron:build:win",
    "prod:start": "npx pm2 start ecosystem.config.js",
    "prod:stop": "npx pm2 stop wanhong-surveystream",
    "prod:restart": "npx pm2 restart wanhong-surveystream",
    "prod:status": "npx pm2 status",
    "prod:logs": "npx pm2 logs wanhong-surveystream",
    "agent:start": "npm --prefix email-survey-agent start",
    "agent:recent": "npm --prefix email-survey-agent run recent",
    "agent:test": "npm --prefix email-survey-agent run test:mock",
    "agent:status": "npm --prefix email-survey-agent run status"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.9",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "imapflow": "^1.0.171",
    "jsonwebtoken": "^9.0.1",
    "mailparser": "^3.7.2",
    "multer": "^2.2.0",
    "node-cron": "^3.0.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.0.0"
  }
}
